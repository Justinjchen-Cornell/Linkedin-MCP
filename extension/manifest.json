{
  "manifest_version": 3,
  "name": "LinkedIn 工作台",
  "version": "0.1.0",
  "description": "采集 LinkedIn 帖子并在本地整理",
  "permissions": ["storage", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": ["https://www.linkedin.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/index.html", "default_title": "LinkedIn 工作台" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
